<!--
  IKE Network — Example Project (Java + docs)
  ══════════════════════════════════════════════

  A standalone Java project that inherits from ike-parent and
  demonstrates the combination of Java source, tests, and the IKE
  documentation pipeline in a single build.

  Build:
    mvn clean verify                       # HTML only
    mvn clean verify -Dike.pdf.prawn       # HTML + Prawn PDF
-->
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0
         http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>network.ike.platform</groupId>
        <artifactId>ike-parent</artifactId>
        <version>159</version>
        <relativePath/>
    </parent>

    <groupId>network.ike.examples</groupId>
    <artifactId>project-example</artifactId>
    <version>36-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>IKE Project Example</name>
    <description>
        Example Java project demonstrating IKE documentation pipeline
        integration with Java source, tests, and Koncept macros.
    </description>
    <url>https://ike.network/project-example/</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <organization>
        <name>IKE Network</name>
        <url>https://ike.network</url>
    </organization>

    <!-- Locally declared so the cascade's coordinate-to-repository
         lookup resolves a real repo URL, not the artifactId-appended
         path Maven would otherwise inherit from ike-parent.
         See IKE-Network/ike-issues#496. -->
    <scm>
        <connection>scm:git:https://github.com/IKE-Network/project-example.git</connection>
        <developerConnection>scm:git:git@github.com:IKE-Network/project-example.git</developerConnection>
        <url>https://github.com/IKE-Network/project-example</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <!-- This is a worked example, not a library. Override the
             Tier 0 default so ike:release-publish ships internally
             only (tag + Nexus + GitHub Release + gh-pages site)
             without publishing to Maven Central. Documented in
             ike-network-site index.adoc § Examples. -->
        <ike.publishToCentral>false</ike.publishToCentral>
        <!-- Examples tier — sentry-orange chrome per
             IKE-Network/ike-issues#545, #546. Distinguishes worked
             examples from foundation (sentry-green) under ike.network. -->
        <ike.site.deployment>ike-network-example</ike.site.deployment>
        <!-- Intra-workspace upstream: the documentation project this
             example builds against. The property is the workspace
             cascade's tracking point — ws:align converges it, a release
             of doc-example cascade-pulls this project, and the release
             SNAPSHOT gate refuses to ship while it points at a
             SNAPSHOT (IKE-Network/ike-issues#501). -->
        <doc-example.version>35</doc-example.version>
    </properties>

    <distributionManagement>
        <site>
            <id>ike-site</id>
            <url>https://ike.network/${project.artifactId}/</url>
        </site>
    </distributionManagement>

    <dependencies>
        <!-- Intra-workspace knowledge dependency (#501): this example
             consumes its sibling documentation project, giving the
             workspace a real doc-example → project-example edge for the
             release cascade to exercise. pom-type: doc-example is the
             classifier-canonical doc shape (#321), so the POM artifact
             is its resolvable coordinate. -->
        <dependency>
            <groupId>network.ike.examples</groupId>
            <artifactId>doc-example</artifactId>
            <version>${doc-example.version}</version>
            <type>pom</type>
            <scope>provided</scope>
        </dependency>

        <!-- IKE Build Standards — Claude instruction files.
             Version managed by ike-parent.
             scope=provided: not needed at runtime, only unpacked at validate. -->
        <dependency>
            <groupId>network.ike.tooling</groupId>
            <artifactId>ike-build-standards</artifactId>
            <classifier>claude</classifier>
            <type>zip</type>
            <scope>provided</scope>
        </dependency>

        <!-- IKE Build Standards — shared build config (checkstyle, PMD, etc.). -->
        <dependency>
            <groupId>network.ike.tooling</groupId>
            <artifactId>ike-build-standards</artifactId>
            <classifier>config</classifier>
            <type>zip</type>
            <scope>provided</scope>
        </dependency>

        <!-- IKE Documentation Resources — themes, assembly descriptors, configs. -->
        <dependency>
            <groupId>network.ike.docs</groupId>
            <artifactId>ike-doc-resources</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- DocBook XSL — stylesheets for XEP/FOP DocBook→XSL-FO→PDF pipeline. -->
        <dependency>
            <groupId>network.ike.docs</groupId>
            <artifactId>docbook-xsl</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Fonts for PDF generation (minimal subset - 13 TTFs, ~4MB) -->
        <dependency>
            <groupId>network.ike.docs</groupId>
            <artifactId>minimal-fonts</artifactId>
            <type>zip</type>
        </dependency>

        <!-- Test Dependencies — versions managed by ike-parent -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Maven Site Plugin — wire asciidoctor-parser-doxia-module so
                 src/site/asciidoc/*.adoc actually renders at site:site time.
                 Without this, maven-site-plugin ignores .adoc files and the
                 generated index.html is the auto-generated "About" page.
                 Mirrors the fix #310 applied to ike-platform/ike-tooling.
                 Once ike-parent picks up the same wiring (followup on #310)
                 this block can be removed. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-site-plugin</artifactId>
                <dependencies>
                    <dependency>
                        <groupId>org.asciidoctor</groupId>
                        <artifactId>asciidoctor-parser-doxia-module</artifactId>
                        <version>3.2.0</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
